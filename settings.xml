<plugin_settings>
	<setting type="bool">
		<name>enabled</name>
		<value>false</value>
	</setting>
	<setting type="int">
		<name>seq</name>
		<value>0</value>
	</setting>
	<setting type="int">
		<name>context</name>
		<value>1</value><!-- BLOCK_CONTEXT_SIDEBAR -->
	</setting>
	<setting type="int">
		<name>yearStart</name>
		<value>0</value><!-- 0 = no lower bound: every published article -->
