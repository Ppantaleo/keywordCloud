	<setting type="int">
		<name>yearEnd</name>
		<value>0</value><!-- 0 = no upper bound: every published article -->
	</setting>
	<setting type="bool">
		<name>showPeriod</name>
		<value>false</value>
	</setting>
</plugin_settings>
